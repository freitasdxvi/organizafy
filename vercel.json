{
  "redirects": [
    { "source": "/avanca/:path*", "destination": "/persiste/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/extensions/storys-com-link.zip",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
